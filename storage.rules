rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Igual que firestore.rules: sin cuentas por usuario, cualquier persona
    // autenticada (incluye anónimos) que conozca el código de casa puede
    // leer/escribir las fotos de esa casa.
    match /households/{householdCode}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
