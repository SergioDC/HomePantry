<resources>
    <!-- La app es siempre oscura (Nocturne), sin seguir el modo del móvil: tema base oscuro,
         fondo de ventana igual al de Compose (sin destello blanco al abrir) y sin "force dark". -->
    <style name="Theme.ListaDeLaCasa" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF161826</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Splash: fondo Nocturne + logo de la app; al terminar pasa al tema normal. -->
    <style name="Theme.ListaDeLaCasa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF161826</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ListaDeLaCasa</item>
    </style>
</resources>
